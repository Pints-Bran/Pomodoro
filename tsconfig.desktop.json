{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // DOM only because electron.d.ts extends HTMLElement; this code runs in Node.
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "desktop",
    "outDir": "dist-desktop",
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["desktop/**/*.ts", "desktop/**/*.cts"]
}
